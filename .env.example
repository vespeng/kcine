# ============================================
# KVideo Lite 环境变量示例
# 复制本文件为 .env 后按需修改
# 所有变量均不使用 NEXT_PUBLIC_ 前缀
# ============================================

# ---- 站点自定义 ----
# 站点名称（导航栏显示）
# SITE_NAME=KVideo Lite
# 浏览器标签页标题
# SITE_TITLE=KVideo Lite - 视频聚合平台
# 站点描述
# SITE_DESCRIPTION=视频聚合平台
# 站点图标文件路径（Docker 容器内相对/绝对路径）
# SITE_ICON_FILE=/app/public/icon.png
# 站点图标 URL（优先于 SITE_ICON_FILE）
# SITE_ICON_URL=https://example.com/icon.png

# ---- 认证相关 ----
# 管理员密码（开启访问密码门）
# ADMIN_PASSWORD=admin123
# 高级内容独立密码（开启高级内容密码门）
# PREMIUM_PASSWORD=premium456
# 多账户配置，格式：用户名:密码:名称[:角色[:权限]]，多个用逗号分隔
# ACCOUNTS=user1:pass1:用户一:viewer,user2:pass2:用户二:admin
# 访问密码（与 ADMIN_PASSWORD 二选一）
# ACCESS_PASSWORD=
# 托管账户模式密钥（需配合 Redis 使用）
# AUTH_SECRET=
# 强制使用托管账户模式（true/false）
# MANAGED_AUTH_ENABLED=false
# 会话持久化（true/false，默认 true）
# PERSIST_SESSION=true
# Upstash Redis REST URL（托管账户与跨设备数据同步）
# UPSTASH_REDIS_REST_URL=
# Upstash Redis REST Token
# UPSTASH_REDIS_REST_TOKEN=

# ---- 功能配置 ----
# 自动订阅源：JSON 数组或 URL（多个用逗号分隔）
# SUBSCRIPTION_SOURCES=
# IPTV 直播源：JSON 数组或 URL
# IPTV_SOURCES=
# 合并同名源（true/1）
# MERGE_SOURCES=
# 弹幕 API 地址
# DANMAKU_API_URL=
# 广告过滤关键词（逗号/换行分隔）
# AD_KEYWORDS=
# 广告过滤关键词文件路径（优先于 AD_KEYWORDS）
# AD_KEYWORDS_FILE=

# ---- 网络配置 ----
# 应用端口（默认 3000）
# PORT=3000
# 绑定主机名（默认 localhost；允许局域网访问时为 0.0.0.0）
# HOSTNAME=0.0.0.0
# 允许局域网访问（true/1）
# ALLOW_LAN_ACCESS=false
# 局域网额外允许的来源（host、host:port 或 *.domain，空格/逗号分隔）
# LAN_ALLOWED_DEV_ORIGINS=

# ---- 平台自动注入（一般无需配置，仅供参考）----
# NODE_ENV=production
# 部署平台自动注入：VERCEL / VERCEL_ENV / CF_PAGES / CF_PAGES_URL / CLOUDFLARE_ACCOUNT_ID / CF_ACCOUNT_ID / WORKERS_CI
